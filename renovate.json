{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>adhese/github-actions"
  ],
  "reviewers": [
    "team:hobbits"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^@types\\/node$/",
        "/^node$/"
      ],
      "matchDatasources": [
        "npm",
        "docker"
      ],
      "groupName": "node"
    }
  ]
}
