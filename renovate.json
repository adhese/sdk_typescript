{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Brussels",
  "schedule": [
    "* 0-23 1 * *"
  ],
  "pruneBranchAfterAutomerge": true,
  "rebaseWhen": "auto",
  "labels": [
    "dependencies"
  ],
  "reviewers": [
    "team:hobbits"
  ],
  "packageRules": [
    {
      "description": "No npm majors (was global — also blocked action bumps)",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "1 week"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "1 month"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "devDependencies"
    },
    {
      "matchPackageNames": [
        "/postcss/",
        "/tailwindcss/"
      ],
      "groupName": "tailwind"
    },
    {
      "matchPackageNames": [
        "/launchdarkly/"
      ],
      "groupName": "launchdarkly"
    },
    {
      "matchPackageNames": [
        "/^@types/node$",
        "/^node$/"
      ],
      "matchDatasources": [
        "npm",
        "docker"
      ],
      "groupName": "node",
      "minimumReleaseAge": "1 week"
    },
    {
      "description": "GitHub Actions: one grouped PR, majors allowed, weekly",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "minimumReleaseAge": "1 week",
      "schedule": [
        "* 0-6 * * 1"
      ]
    }
  ]
}
